# =============================================================================
# Jesbick — modelo de ambiente. Copie para .env.local e preencha.
#
#   cp .env.example .env.local
#
# .env.local nunca é versionado (ver .gitignore). Este arquivo é, e por isso
# não pode conter valor real de nada.
# =============================================================================

# --- app + autenticação (Supabase) -------------------------------------------
# As duas únicas variáveis que o navegador enxerga. NEXT_PUBLIC_* é substituído
# em tempo de build e vai para o bundle: só chave pública entra aqui.
#
# A publishable key é pública por construção e está sujeita a RLS
# (supabase/migrations/0004_rls.sql: leitura em tudo, escrita em nada).
# São as mesmas variáveis usadas pela busca e pelo Supabase Auth — autenticação
# não trouxe segredo novo para o projeto.
#
# Painel do Supabase → Project Settings → API Keys.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# --- somente scripts/, na sua máquina ----------------------------------------
# Nada abaixo desta linha existe no runtime da Vercel.

# Embeddings do corpus (scripts/embed.ts) e da consulta em runtime.
OPENAI_API_KEY=sk-...

# Conexão direta ao Postgres — pooler, porta 6543, modo transaction.
# Usada só por scripts/ (seed, normalize, audit). O app em serverless fala com o
# banco por PostgREST/HTTPS: pool de conexão direta esgota em função serverless.
DATABASE_URL=postgresql://postgres.SEU-PROJETO:SENHA@aws-0-REGIAO.pooler.supabase.com:6543/postgres

# A service role NUNCA entra em src/. Ela ignora RLS: exposta no bundle do
# cliente, abre o banco inteiro para escrita. Se algum script precisar dela,
# declare aqui — sem prefixo NEXT_PUBLIC_, jamais.
# SUPABASE_SERVICE_ROLE_KEY=
